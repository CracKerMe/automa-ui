{
  "name": "vue-ts-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "cross-env vite build --mode analyze",
    "preview": "vite preview",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:prettier",
    "lint:eslint": "cross-env eslint --cache --ext .js,.jsx,.ts,.tsx,.vue --fix .",
    "lint:prettier": "prettier --write .",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,less,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/ --config .stylelintrc.cjs",
    "commit": "git-cz",
    "release": "npx bumpp --push --tag --commit 'release: v'",
    "postinstall": "npx msw init public --save",
    "prepare": "husky",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:update": "vitest run --update",
    "type:check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^13.4.0",
    "@vueuse/integrations": "^13.4.0",
    "axios": "^1.10.0",
    "element-plus": "^2.10.2",
    "fabric": "^6.7.0",
    "gsap": "^3.13.0",
    "pinia": "^3.0.3",
    "universal-cookie": "^8.0.1",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.7",
    "vue-router": "^4.5.1",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-window": "^7.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@iconify-json/carbon": "^1.2.10",
    "@iconify-json/ic": "^1.2.2",
    "@iconify-json/material-symbols": "^1.2.28",
    "@iconify-json/tdesign": "^1.2.8",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@pinia/testing": "^1.0.2",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/node": "^24.0.10",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "bumpp": "^10.2.0",
    "commitizen": "^4.3.1",
    "commitlint-config-cz": "^0.13.3",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.4.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "msw": "^2.10.2",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.17",
    "rollup": "^4.44.1",
    "sass": "^1.89.2",
    "standard-version": "^9.5.0",
    "stylelint": "^16.21.0",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "3",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^7.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.0.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "msw": {
    "workerDirectory": "public"
  }
}
